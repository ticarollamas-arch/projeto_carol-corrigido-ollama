# ==============================================================================
# ZipToGit & Reverse Engineering Architect - Environment Variables
# ==============================================================================

# NVIDIA NIM Free Tier (build.nvidia.com) - Meta Llama 3.3, Mistral, DeepSeek
NVIDIA_API_KEY=sua_chave_aqui

# OpenAI API Key (platform.openai.com) - GPT-4o, GPT-4o-mini, o3-mini
OPENAI_API_KEY=

# DeepSeek API Key (platform.deepseek.com) - deepseek-chat (V3), deepseek-reasoner (R1)
DEEPSEEK_API_KEY=

# Groq Cloud API Key (console.groq.com) - Meta Llama 3.3 70B ultra-fast inference
GROQ_API_KEY=

# Ollama Cloud (requires API key)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# For Ollama running on the SAME server, use http://127.0.0.1:11434/v1 and leave OLLAMA_API_KEY empty

# Optional  API Key
GEMINI_API_KEY=

# Port for HTTP server (defaults to 3000)
PORT=3000

# Optional default provider: ollama, nvidia, openai, deepseek, groq, custom
AI_PROVIDER=ollama
